# Copy to /opt/bloodinfo-app/deploy/.env on the VPS. Never commit real .env files.
# Safety gates stay false until production credentials and existing data are ready.
DEPLOY_ENABLED=false
DATA_MIGRATION_CONFIRMED=false
CERTBOT_EMAIL=
# If a previous standalone BloodInfo volume exists, manually restore uploads and
# WhatsApp .sessions into bloodinfo_uploads / bloodinfo_sessions, then confirm above.
# Database names/collections are retained; do not rename the existing database.
